{
  "name": "mocho-pedidos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "supabase": "supabase",
    "backup:supabase": "powershell -ExecutionPolicy Bypass -File scripts/backup-supabase.ps1",
    "build": "node scripts/build.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-db.mjs migrate",
    "db:grant": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-db.mjs grant",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12",
    "pg": "8.16.3",
    "supabase": "2.114.0"
  },
  "dependencies": {
    "@neon/config": "1.9.2",
    "@neon/env": "1.6.3",
    "@neon/functions": "0.11.0",
    "@neondatabase/neon-js": "0.8.0-beta",
    "jose": "6.1.0"
  }
}
